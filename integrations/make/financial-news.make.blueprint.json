      "id": 5,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {},
      "mapper": {
        "to": [
          "{{4.`1`}}"
        ],
        "content": "<div style=\"background-color:#edf1f5; padding:24px 12px; font-family:Arial,sans-serif;\">\n\n    <div style=\"max-width:640px; margin:0 auto;\">\n\n        <div style=\"background-color:#10263c; padding:32px; border-radius:10px;\">\n\n            <p style=\"color:#9fb5c9; font-size:11px; letter-spacing:2px;\">\n                INFORMAÇÃO • ECONOMIA • MERCADO\n            </p>\n\n            <h1 style=\"color:#ffffff; font-size:32px; margin:12px 0;\">\n                Financial News\n            </h1>\n\n            <p style=\"color:#cbd5e1; font-size:14px;\">\n                Seu boletim diário do mercado financeiro\n            </p>\n\n        </div>\n\n        <div style=\"padding:24px 8px;\">\n\n            <p style=\"color:#64748b; font-size:12px;\">\n                {{formatDate(now; \"DD/MM/YYYY\"; \"America/Sao_Paulo\")}}\n            </p>\n\n            <h2 style=\"color:#10263c;\">\n                Olá, {{4.`0`}}!\n            </h2>\n\n            <p style=\"color:#475569; font-size:15px; line-height:1.7;\">\n                Confira nossa seleção das principais notícias\n                do mercado financeiro nacional e internacional.\n            </p>\n\n        </div>\n\n        {{3.text}}\n\n        <div style=\"text-align:center; padding:24px 12px; color:#64748b; font-size:12px; line-height:1.8;\">\n\n            <p>Até o próximo boletim!</p>\n\n            <p>\n                Boletim produzido com auxílio de inteligência artificial.\n                <br>\n                Conteúdo informativo. Não constitui recomendação de investimento.\n            </p>\n\n            <p style=\"color:#10263c; font-weight:bold; letter-spacing:2px;\">\n                FINANCIAL NEWS © 2026\n            </p>\n\n        </div>\n\n    </div>\n\n</div>",
        "subject": "Financial News | Boletim diário",
